{
  "name": "ngr-barbearia-backend",
  "version": "1.0.0",
  "description": "Backend da NGR Barbearia — WhatsApp + IA + agendamento",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --require ts-node/register/transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "simulate": "node --require ts-node/register/transpile-only scripts/simulate-conversation.ts",
    "create-owner": "node --require ts-node/register/transpile-only scripts/create-owner.ts",
    "test": "node --require ts-node/register/transpile-only --test src/**/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.4",
    "node-cron": "^3.0.3",
    "openai": "^4.104.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11"
  }
}
