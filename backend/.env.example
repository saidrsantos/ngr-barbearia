# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ngr_barbearia

# Auth do painel admin
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# CORS (URLs do painel admin, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# OpenAI (conta própria da NGR — não usa a mesma chave de nenhum outro sistema)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-para-o-passo-de-verificacao-do-webhook
WHATSAPP_APP_SECRET=
# Nomes dos templates cadastrados/aprovados no Meta Business Manager
WHATSAPP_TEMPLATE_REMINDER=lembrete_agendamento
WHATSAPP_TEMPLATE_RECOVERY=recuperacao_cliente
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Fonte de verdade da agenda: "internal" até o acesso ao App Barber ser liberado,
# depois trocar para "appbarber" sem mudar nenhum outro código.
APPOINTMENT_PROVIDER=internal

# Nome/telefone da barbearia usados no prompt da IA e nas notificações internas
BUSINESS_NAME="NGR Barbearia"
OWNER_NOTIFICATION_WHATSAPP_NUMBER=
